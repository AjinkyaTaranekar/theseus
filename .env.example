# Copy to .env and fill in what you need. Never commit .env.
# Every variable is described in docs/spec/07-github-and-deploy.md ("Environment variables").
# A blank value means the default.

# replay (default), record or live for model calls
THESEUS_MODE=

# The LLM, through LiteLLM. Defaults: GLM 5.3 and GLM 5.3 Flash on Crusoe.
# To switch models, set all three of LLM_MODEL, LLM_API_BASE and LLM_API_KEY.
LLM_MODEL=
LLM_FAST_MODEL=
LLM_API_BASE=
LLM_API_KEY=

# Jev (TypeSafe)
TYPESAFE_API_KEY=
JEV_BASE_URL=
JEV_MODEL=

# FalkorDB Cloud
FALKORDB_HOST=
FALKORDB_PORT=
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=

# The GitHub App
GITHUB_APP_ID=
# The App's private key lives in secrets/, which git ignores; never commit it. Under Compose, use
# /app/secrets/theseus.private-key.pem (deploy/docker-compose.yml mounts secrets/ there).
GITHUB_APP_PRIVATE_KEY_PATH=secrets/theseus.private-key.pem
GITHUB_WEBHOOK_SECRET=

# The backend
THESEUS_TOKEN=
THESEUS_REPOS=
THESEUS_WORLD_ROOT=
# The advisory feed folder the posture run checks main against (default: advisories)
THESEUS_ADVISORIES=
DOMAIN=
